# --- Provider selection ---
# Which LLM provider family to use: "zai" (default) or "opencode-go".
LLM_PROVIDER=zai
# Wire protocol to use. Leave empty to let the capability map auto-route per model.
# zai: openai (only)
# opencode-go: per-model — GLM/Kimi/MiMo/Qwen/DeepSeek route through openai;
#              MiniMax routes through anthropic. Setting this explicitly will
#              hard-fail if it conflicts with the chosen model.
LLM_ENDPOINT_FAMILY=

# --- Z.AI (used when LLM_PROVIDER=zai) ---
ZAI_API_KEY=your-zai-api-key-here
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5

# --- OpenCode Go (used when LLM_PROVIDER=opencode-go) ---
# Subscription plan with a $12 / 5-hour, $30 / week, $60 / month dollar cap.
# There is no public usage-query API yet, so Deep Research only reacts to
# rate-limit errors — set LLM_FALLBACK_PROVIDER below to keep a long run
# going if you hit the cap mid-research.
#
# Approx. LLM call volume per run (excludes search, which is free):
#   --depth quick    ~15-20 calls   safest under all caps
#   --depth standard ~30-60 calls   typically safe; a few runs per 5h window
#   --depth deep     ~90-100 calls  significant share of the 5h cap
#   --agent (any)    up to 8 iters; combine with --depth deep at your own risk
#
# Get an API key from https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# Examples: glm-5.1, kimi-k2.6, minimax-m2.7, deepseek-v4-pro, qwen3.6-plus
OPENCODE_MODEL=glm-5.1

# Fallback provider used when the primary trips a rate-limit / cap. Set to
# another configured provider name (e.g. "zai" while primary is "opencode-go")
# so the run can finish when the OpenCode Go cap is hit. Empty = block cleanly
# with a ProviderLimitExceeded error.
LLM_FALLBACK_PROVIDER=

# Optional — DuckDuckGo is used as a free fallback when Tavily is not set
TAVILY_API_KEY=

# Optional — increases Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=

# Optional — research depth default (quick / standard / deep)
RESEARCH_DEPTH=standard

# --- Concurrency & rate-limit controls ---
# Lower these if a provider rate-limits (e.g. Z.AI/GLM 429s) during
# deep/agent runs. They cap how bursty a single research run is.
#
# Concurrent in-flight LLM calls during source analysis (analyze + summary
# + optional extract per source). Default 5.
MAX_LLM_CONCURRENCY=5
# Gentler ceiling applied automatically in --agent mode (capped by
# MAX_LLM_CONCURRENCY). Agent mode adds decision/gap calls, so it's burstier.
AGENT_MAX_LLM_CONCURRENCY=3
# Concurrent search + content-extraction HTTP requests across all providers.
MAX_SEARCH_CONCURRENCY=5

# Retry/backoff for transient + rate-limit errors. Rate limits get a 3x
# longer base wait; jitter is always applied to avoid synchronized retries.
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_SECONDS=2.0
LLM_RETRY_MAX_SECONDS=60.0

# Optional research-shape overrides. Unset / 0 = use the --depth preset.
# Useful to shrink a run further on a tight budget.
# MAX_SUB_QUESTIONS=
# MAX_SEARCH_RESULTS=
# MAX_ITERATIONS=
# MAX_SOURCES=

# Optional agent-mode iteration budgets per depth (0 = built-in default of
# quick 3 / standard 5 / deep 8, always capped at 8). Lower the deep budget
# for ad-hoc/manual runs to keep them from burning through a rate-limit cap.
# AGENT_BUDGET_QUICK=
# AGENT_BUDGET_STANDARD=
# AGENT_BUDGET_DEEP=

# --- Stage routing ---
# Named profile that fills the four pipeline stages. Per-stage env vars below
# still win when set. Available profiles per provider:
#
#   zai:
#     balanced  — glm-4.5-air (decompose) + glm-5.1 (analyze/gap/synth)  [PRODUCTION]
#
#   opencode-go:
#     balanced  — glm-5.1 for every stage (production-tier safe default) [PRODUCTION]
#     budget    — deepseek-v4-flash for decompose+analyze,               [EXPERIMENTAL]
#                 glm-5.1 for gap_analysis+synthesize
#     quality   — glm-5.1 for decompose/analyze/gap_analysis,            [EXPERIMENTAL]
#                 deepseek-v4-pro for synthesize
LLM_ROUTE=balanced

# Per-stage overrides (leave empty to use the active LLM_ROUTE profile).
# Production-tier OpenCode Go models: glm-5, glm-5.1
# Experimental OpenCode Go models:    kimi-k2.5/k2.6, mimo-v2.5/v2.5-pro,
#                                     qwen3.5-plus/3.6-plus, deepseek-v4-pro/flash,
#                                     minimax-m2.5/m2.7 (anthropic family)
MODEL_DECOMPOSE=
MODEL_ANALYZE=
MODEL_SYNTHESIZE=
MODEL_GAP_ANALYSIS=
