# --- Provider selection ---
# Which LLM provider to use. Z.AI is the only one for now.
LLM_PROVIDER=zai

# --- Z.AI (used when LLM_PROVIDER=zai) ---
ZAI_API_KEY=your-zai-api-key-here
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# The default model (shown in `status`, used for any call that doesn't name a
# model). Pipeline stages use the models chosen in setup (see "Models per pipeline
# stage" below), not this one.
GLM_MODEL=glm-5.3

# Optional — DuckDuckGo is used as a free fallback when Tavily is not set
TAVILY_API_KEY=

# Optional — increases Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=

# Optional — research depth default (quick / standard / deep)
RESEARCH_DEPTH=standard

# --- Concurrency & rate-limit controls ---
# Lower these if a provider rate-limits (e.g. Z.AI/GLM 429s) during
# deep/agent runs. They cap how bursty a single research run is.
#
# Concurrent in-flight LLM calls during source analysis (analyze + summary
# + optional extract per source). Default 2 — the Z.AI GLM coding plan
# enforces a low per-plan concurrency cap, so wider fan-outs mostly buy 429
# retries. Raise to 3-5 only on providers with concurrency headroom.
MAX_LLM_CONCURRENCY=2
# Gentler ceiling applied automatically in --agent mode (capped by
# MAX_LLM_CONCURRENCY). Agent mode adds decision/gap calls, so it's burstier.
AGENT_MAX_LLM_CONCURRENCY=3
# Concurrent search + content-extraction HTTP requests across all providers.
MAX_SEARCH_CONCURRENCY=5

# Retry/backoff for transient + rate-limit errors. Rate limits get a 3x
# longer base wait; jitter is always applied to avoid synchronized retries.
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_SECONDS=2.0
LLM_RETRY_MAX_SECONDS=60.0

# Optional research-shape overrides. Unset / 0 = use the --depth preset.
# Useful to shrink a run further on a tight budget.
# MAX_SUB_QUESTIONS=
# MAX_SEARCH_RESULTS=
# MAX_ITERATIONS=
# MAX_SOURCES=

# Optional agent-mode iteration budgets per depth (0 = built-in default of
# quick 3 / standard 5 / deep 8, always capped at 8). Lower the deep budget
# for ad-hoc/manual runs to keep them from burning through a rate-limit cap.
# AGENT_BUDGET_QUICK=
# AGENT_BUDGET_STANDARD=
# AGENT_BUDGET_DEEP=

# --- Models per pipeline stage ---
# Each stage of a run uses its own model: decompose (splits your question),
# analyze (reads each source — most of the calls), gap_analysis (decides what is
# missing) and synthesize (writes the report). You normally choose these in the
# setup screen (`synapse-deep-research setup`, also opened on first launch) or with
# `/model` in the REPL; the choice is saved to ~/.config/synapse-deep-research/config.json
# and nothing here is needed.
#
# The variables below OVERRIDE the saved choice — handy for CI and scripts.
# Leave them empty to use what you chose in setup (or, if you never chose, the
# provider's recommendation): decompose/analyze glm-5.3-flash,
# gap_analysis/synthesize glm-5.3.
#
# Registered Z.AI models:  glm-5.3, glm-5.3-flash, glm-5.3-flashx, glm-5.2, glm-5.1
# Any other ID your provider serves also works (it is accepted with a warning).
MODEL_DECOMPOSE=
MODEL_ANALYZE=
MODEL_SYNTHESIZE=
MODEL_GAP_ANALYSIS=
